# Create workbook
# -----------------------------
guide = pd.DataFrame([
    ["Purpose", "Pairwise LASA screening using orthographic + phonetic name similarity, with separate strength and pack-size/context scores."],
    ["Important", "The composite score and cutoffs are provisional and must not be described as clinically validated until tested against an independent reference standard/expert panel."],
    ["Orthographic similarity", "O = 0.70*Levenshtein + 0.30*Jaro-Winkler, each normalized 0–1."],
    ["Levenshtein", "L = 1 - edit_distance(core_A, core_B) / max(length(core_A), length(core_B))."],
    ["Phonetic similarity", "P = 0.50*consonant-skeleton Jaro-Winkler + 0.50*Soundex exact-match indicator."],
    ["Name LASA score", "NameScore = 100*(0.45*O + 0.55*P)."],
    ["Strength similarity", "For matching units, S = max(0, 1 - |log10(value_A/value_B)|/2); otherwise 0. Missing if either drug has no parsed strength."],
    ["Pack-size similarity", "Same numeric/unit decay formula as strength, currently applied to ml/l/ds pack expressions. Missing if either side has no parsed pack size."],
    ["Context score", "Context = mean(Strength similarity, Pack-size similarity) when one or both are available."],
    ["Provisional composite", "Composite = NameScore when context is unavailable; otherwise 0.85*NameScore + 0.15*ContextScore."],
    ["Why keep context separate?", "Strength and pack size are medication-use/context variables, not pure LASA-name similarity. Keeping them separate makes the model easier to validate and interpret."],
    ["Validation recommendation", "Use ISMP/expert LASA classification as the reference label; estimate ROC/AUC, sensitivity, specificity, PPV, NPV, Youden J, and bootstrap confidence intervals."],
    ["Phonetic limitation", "The current phonetic component is a transparent prototype using Soundex + consonant-skeleton similarity. For a publication-grade English model, compare/validate it against a stronger phonetic representation and human pronunciation ratings."],
    ["Language limitation", "Soundex is English-oriented. Thai or multilingual drug names require a language-appropriate phonetic method or human pronunciation coding."],
], columns=["Item","Definition"])

formula_examples = pd.DataFrame([
    ["Example", "Levenshtein", "O = 0.70*L + 0.30*JW", "Name = 100*(0.45*O + 0.55*P)", "Context", "Composite"],
])
# Put a few real examples with computed values
ex = analysis.head(10).copy()
example_rows=[]
for _,r in ex.iterrows():
