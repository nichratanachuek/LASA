        f"O=0.70×{r.Levenshtein_Similarity:.4f}+0.30×{r.Jaro_Winkler_Similarity:.4f}={r.Orthographic_Similarity:.4f}",
        f"Name=100×(0.45×{r.Orthographic_Similarity:.4f}+0.55×{r.Phonetic_Similarity:.4f})={r.Name_LASA_Score_0_100:.2f}",
        "" if pd.isna(r.Contextual_Strength_Pack_Score_0_100) else f"{r.Contextual_Strength_Pack_Score_0_100:.2f}",
        f"{r.Provisional_Composite_Score_0_100:.2f}"
    ])
formula_examples = pd.DataFrame(example_rows, columns=["Pair","Orthographic inputs","Orthographic formula","Name-score formula","Context score","Composite score"])

with pd.ExcelWriter(output_xlsx, engine="openpyxl") as writer:
    analysis.to_excel(writer, sheet_name="Pair_Analysis", index=False)
    guide.to_excel(writer, sheet_name="Scoring_Guide", index=False)
    formula_examples.to_excel(writer, sheet_name="Formula_Examples", index=False)
    unpaired.to_excel(writer, sheet_name="Unpaired_Drugs", index=False)

# Formatting
