import pandas as pd, numpy as np, re, math, unicodedata, os, textwrap
from rapidfuzz.distance import Levenshtein, JaroWinkler
from openpyxl import load_workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter

input_path = "/mnt/data/IOR drug name M3-4 - pair.xlsx"
output_xlsx = "/mnt/data/IOR_drug_pair_LASA_similarity_analysis.xlsx"
output_py = "/mnt/data/lasa_similarity_analysis.py"

df = pd.read_excel(input_path)

# -----------------------------
# Similarity / parsing functions
# -----------------------------
def clean_name(s):
    s = str(s).lower().strip()
    s = re.sub(r'\([^)]*\)', ' ', s)
    # Remove common dose/pack expressions from the core name.
    s = re.sub(
        r'\b\d+(?:[.,]\d+)?\s*(?:mg/ml|mcg/ml|ug/ml|mg/dl|mg/g|mg/ds|mcg/ds|'
        r'mg|mcg|µg|ug|g|kg|ml|l|gm|%|iu|units?|meq|mmol|mm|cm|ds)\b',
        ' ', s, flags=re.I
    )
    s = re.sub(r'[^a-z]+', ' ', s)
    return re.sub(r'\s+', ' ', s).strip()

def lev_sim(a, b):
    a, b = clean_name(a), clean_name(b)
    if not a and not b: return 1.0
    if not a or not b: return 0.0
    return 1 - Levenshtein.distance(a, b) / max(len(a), len(b))

def jw_sim(a, b):
    a, b = clean_name(a), clean_name(b)
    return JaroWinkler.normalized_similarity(a, b) if a and b else 0.0

def soundex(s):
    s = unicodedata.normalize('NFKD', str(s)).encode('ascii','ignore').decode().upper()
    s = re.sub('[^A-Z]', '', s)
    if not s: return ''
    first = s[0]
    mp = {
        'B':'1','F':'1','P':'1','V':'1',
        'C':'2','G':'2','J':'2','K':'2','Q':'2','S':'2','X':'2','Z':'2',
        'D':'3','T':'3','L':'4','M':'5','N':'5','R':'6'
    }
    out, prev = first, mp.get(first, '0')
    for ch in s[1:]:
        code = mp.get(ch, '0')
        if code != '0' and code != prev:
            out += code
            if len(out) == 4: break
        prev = code
    return (out + '000')[:4]

def consonant_skeleton(s):
    s = unicodedata.normalize('NFKD', str(s)).encode('ascii','ignore').decode().lower()
    s = re.sub('[^a-z]', '', s)
    return re.sub('[aeiouy]', '', s)

def phonetic_score(a, b):
    ca, cb = consonant_skeleton(a), consonant_skeleton(b)
    if not ca or not cb: return 0.0
    skeleton_jw = JaroWinkler.normalized_similarity(ca, cb)
    sx = 1.0 if soundex(a) == soundex(b) else 0.0
    return 0.5 * skeleton_jw + 0.5 * sx

unit_pat = r'(?:mg|mcg|µg|ug|g|kg|ml|l|gm|%|iu|units?|meq|mmol|mm|cm|ds)'
measure_re = re.compile(
    rf'(\d+(?:[.,]\d+)?)\s*({unit_pat}(?:\s*/\s*{unit_pat})?)', re.I
)
strength_units = {
    'mg','mcg','ug','g','kg','iu','units','unit','meq','mmol','%',
    'mg/ml','mcg/ml','ug/ml','mg/g','mg/dl','mg/ds','mcg/ds'
}

def extract_measurements(s):
    s = str(s).lower().replace('µ','u').replace('μ','u')
    out = []
    for m in measure_re.finditer(s):
        out.append((float(m.group(1).replace(',','.')), re.sub(r'\s+','',m.group(2))))
    return out

def strength_tokens(s):
    return [(v,u) for v,u in extract_measurements(s)
            if u in strength_units or '/' in u]

def pack_tokens(s):
    return [(v,u) for v,u in extract_measurements(s)
            if u in {'ml','l','ds'}]

def measurement_similarity(v1, v2):
    if not v1 or not v2:
        return np.nan
    best = 0.0
    for x1,u1 in v1:
        for x2,u2 in v2:
            if u1 == u2:
                rel = abs(math.log10(x1/x2)) if x1 > 0 and x2 > 0 else 99
                score = max(0.0, 1.0 - rel/2.0)
            else:
                score = 0.0
            best = max(best, score)
    return best

def fmt(vals):
    return "; ".join(f"{v:g} {u}" for v,u in vals)

# -----------------------------
# Prepare pairs
# -----------------------------
d = df.copy()
for c in ["drugA","drugB"]:
    d[c] = d[c].astype(str).str.strip()
    d.loc[d[c].isin(["(blank)", "nan", "None", ""]), c] = np.nan

pairs = d.dropna(subset=["drugB"]).copy()

records = []
for a,b in pairs[["drugA","drugB"]].itertuples(index=False, name=None):
    L = lev_sim(a,b)
    JW = jw_sim(a,b)
    O = 0.7*L + 0.3*JW
    P = phonetic_score(a,b)

    stA, stB = strength_tokens(a), strength_tokens(b)
    pkA, pkB = pack_tokens(a), pack_tokens(b)
    SS = measurement_similarity(stA, stB)
    PS = measurement_similarity(pkA, pkB)

    name_score = 100*(0.45*O + 0.55*P)
    context_values = [x for x in [SS, PS] if not pd.isna(x)]
    context_score = 100*np.mean(context_values) if context_values else np.nan

    # Provisional screening composite only; NOT a validated clinical cutoff.
    composite = name_score if pd.isna(context_score) else 0.85*name_score + 0.15*context_score

    records.append({
        "Pair_ID": len(records)+1,
        "Drug_A": a,
        "Drug_B": b,
        "A_Core_Name": clean_name(a),
        "B_Core_Name": clean_name(b),
        "Levenshtein_Similarity": L,
        "Jaro_Winkler_Similarity": JW,
        "Orthographic_Similarity": O,
        "Soundex_A": soundex(a),
        "Soundex_B": soundex(b),
        "Consonant_Skeleton_A": consonant_skeleton(a),
        "Consonant_Skeleton_B": consonant_skeleton(b),
        "Phonetic_Similarity": P,
        "Strength_A": fmt(stA),
        "Strength_B": fmt(stB),
        "Strength_Similarity": SS,
        "Pack_A": fmt(pkA),
        "Pack_B": fmt(pkB),
        "Pack_Size_Similarity": PS,
        "Name_LASA_Score_0_100": name_score,
        "Contextual_Strength_Pack_Score_0_100": context_score,
        "Provisional_Composite_Score_0_100": composite
    })

analysis = pd.DataFrame(records)

# Provisional categories are for screening only.
def category(x):
    if pd.isna(x): return ""
    if x >= 80: return "Very high"
    if x >= 60: return "High"
    if x >= 40: return "Moderate"
    if x >= 20: return "Low"
    return "Very low"

analysis["Provisional_Category"] = analysis["Provisional_Composite_Score_0_100"].apply(category)

# Unpaired rows from the original sheet
unpaired = d[d["drugB"].isna()][["drugA"]].rename(columns={"drugA":"Unpaired_Drug"}).drop_duplicates()

